{
  "name": "strimkeep-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node --experimental-strip-types tests/production-smoke.mjs",
    "format": "prettier --write src tests *.ts index.html package.json tsconfig.json .prettierrc.json README.md",
    "format:check": "prettier --check src tests *.ts index.html package.json tsconfig.json .prettierrc.json README.md"
  },
  "dependencies": {
    "@lucide/vue": "1.58.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
