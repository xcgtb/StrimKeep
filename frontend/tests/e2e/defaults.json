{
  "cover": {
    "rules": [
      {
        "key": "release_group",
        "label": "发布组优先级",
        "desc": "按你维护的发布组列表比较；越靠前优先级越高，不在列表内的排最后。",
        "enabled": false,
        "tiers": [],
        "groups": []
      },
      {
        "key": "source",
        "label": "资源类型优先级",
        "desc": "识别 UHD/蓝光/WEB 等片源类型；其他或未识别格式默认排在最后。",
        "enabled": false,
        "tiers": [
          "UHD Remux",
          "Remux",
          "UHD BluRay / BDMV",
          "BluRay",
          "WEB-DL",
          "WEBRip",
          "HDTV",
          "DVD",
          "其他 / 未识别"
        ],
        "groups": []
      },
      {
        "key": "resolution",
        "label": "分辨率优先级",
        "desc": "按画面高度比较；2K/1440p 作为兼容档位保留，未识别分辨率排在最后。",
        "enabled": true,
        "tiers": [
          "4320p / 8K",
          "2160p / 4K",
          "1440p / 2K",
          "1080p",
          "720p",
          "SD（576p 及以下）",
          "其他 / 未识别"
        ],
        "groups": []
      },
      {
        "key": "dolby",
        "label": "动态范围优先级",
        "desc": "Dolby Vision 会细分 P7、P5、P8，并识别 HDR Vivid；未识别格式排在最后。",
        "enabled": true,
        "tiers": [
          "Dolby Vision Profile 7",
          "Dolby Vision Profile 5",
          "Dolby Vision Profile 8",
          "Dolby Vision（未识别 Profile）",
          "HDR10+",
          "HDR Vivid",
          "HDR10",
          "HDR / HLG",
          "SDR",
          "其他 / 未识别"
        ],
        "groups": []
      },
      {
        "key": "fps",
        "label": "帧率优先级",
        "desc": "59.94 / 29.97 / 23.976 会分别归入 60 / 30 / 24 档，未识别帧率排在最后。",
        "enabled": true,
        "tiers": [
          "60 / 59.94 fps",
          "50 fps",
          "30 / 29.97 fps",
          "25 fps",
          "24 / 23.976 fps",
          "其他 / 未识别"
        ],
        "groups": []
      },
      {
        "key": "bitdepth",
        "label": "色深优先级",
        "desc": "识别文件名中的 bit depth；未识别色深排在最后。",
        "enabled": true,
        "tiers": ["12bit", "10bit", "8bit", "其他 / 未识别"],
        "groups": []
      },
      {
        "key": "audio",
        "label": "音频规格优先级",
        "desc": "按文件名中识别到的最高音频规格比较；未识别格式排在最后。",
        "enabled": true,
        "tiers": [
          "TrueHD Atmos / DTS:X",
          "TrueHD / DTS-HD MA",
          "LPCM / FLAC",
          "Audio Vivid / AV3A",
          "DD+ Atmos",
          "DD+ / E-AC-3",
          "DTS",
          "AC3 / DD",
          "AAC",
          "其他 / 未识别"
        ],
        "groups": []
      }
    ]
  },
