# Web 登录（必填）
WEB_USER=admin
WEB_PASSWORD=change-me-please

# 时区
TZ=Asia/Shanghai

# 可选：将连接配置固定在环境变量中；设置后会覆盖 Web 设置页中的对应值
# EMBY_HOST=http://127.0.0.1:8096
# EMBY_KEY=
# TMDB_KEY=
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# TG_ALLOWED_USERS=

# 可选：Emby 媒体库里看到的 STRM 根目录（Emby 容器内路径），用于区分本地/分享库与单剧删除
# 不设置时可在 Web 设置页填写；不确定时在设置页点「测试连接」查看 Emby 报告的路径
# EMBY_LOCAL_PATH=/strm/115网盘/影视媒体库
# EMBY_SHARE_PATH=/strm/115网盘/分享影视库

# 可选：Emby 单次请求超时（秒，默认 30）。库很大或 NAS 繁忙时扫描超时可适当调大；GET 请求超时 / 5xx 会自动重试 2 次
# EMBY_TIMEOUT=30

# 容器内媒体路径固定为 /media/local、/media/share、/media/cloud、/data，
# 只需要在 docker-compose.yml 的 volumes 里挂载宿主机目录，无需配置环境变量。

# CloudDrive2 挂载看门狗：仅控制启动等待，不控制是否联动删除
# ENABLE_CD2_WATCHDOG=1

# 可选：通过反向代理（Nginx / Lucky / NPM 等）访问且代理没有透传 Host / X-Forwarded-Host 时，
# 把你的访问域名加进来（逗号分隔），否则登录后的写操作会被 CSRF 校验拒绝（403）。
# ALLOWED_ORIGINS=https://nas.example.com
