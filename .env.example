# 复制成 .env 再改：cp .env.example .env
# docker-compose.yml 只从这里取值，所以口令不会写进 yml。

TZ=Asia/Shanghai
ADMIN_USERNAME=admin
# 至少 12 位
ADMIN_PASSWORD=

# 可选：/metrics 的口令，留空表示不启用
STRIMKEEP_METRICS_TOKEN=

# 可选：把媒体信息写进 Emby（容器内路径，对应 compose 里的 ./emby/data 挂载）
# 不写媒体信息就留空，两行都不用改
STRIMKEEP_EMBY_LIBRARY_DB=
STRIMKEEP_EMBY_STRM_MOUNT=
