# 复制成 .env 后按自己的环境修改；.env 不要提交到仓库。
TZ=Asia/Shanghai

# Web 管理入口
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码

# /metrics 的访问令牌（留空则关闭保护）
STRIMKEEP_METRICS_TOKEN=

# 宿主机目录（相对路径也可以，例如 ./data）
STRIMKEEP_DATA_DIR=/path/to/strimkeep/data
STRIMKEEP_STRM_DIR=/path/to/strimkeep/strm

# 可选：把 Emby 也纳入 compose 时用
EMBY_CONFIG_DIR=/path/to/emby/config
EMBY_DATA_DIR=/path/to/emby/data
EMBY_PORT=8096

# 可选：媒体信息写入 Emby
# STRIMKEEP_EMBY_LIBRARY_DB=/emby-data/library.db
# STRIMKEEP_EMBY_STRM_MOUNT=/media
