# StrimKeep 配置
#
# 只需要填 1 项：ADMIN_PASSWORD（登录密码，至少 12 位）。
# 其他都不写也没问题，会用注释里的默认值。
#
# 更省事的做法：直接运行  sh install.sh  按提示回答三个问题，
# 它会自动生成这个文件并启动。

# ─────────────────────────────────────────────
# 必填
# ─────────────────────────────────────────────
# 面板登录密码（≥12 位；不要用 changeme / 12345678）
ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# 目录（不写就是当前目录下的 data/ 和 strm/）
# ─────────────────────────────────────────────
# state.db、密钥、日志都在这里。**必须单独备份**
STRIMKEEP_DATA_DIR=./data
# 生成的播放文件（STRM），同时要挂给 Emby
STRIMKEEP_STRM_DIR=./strm

# ─────────────────────────────────────────────
# 一般不用改（去掉行首的 # 才会生效）
# ─────────────────────────────────────────────
# 登录用户名
# ADMIN_USERNAME=admin
# 时区
# TZ=Asia/Shanghai
# 镜像版本：latest 自动跟随最新，想固定就写 0.9.150
# STRIMKEEP_VERSION=latest
# /metrics 访问令牌：留空 = 不校验（内网通常不用管）
# STRIMKEEP_METRICS_TOKEN=

# ─────────────────────────────────────────────
# 可选：连 Emby 一起装（启动时加 --profile emby）
# ─────────────────────────────────────────────
# EMBY_CONFIG_DIR=./emby
# EMBY_DATA_DIR=./emby-data
# EMBY_PORT=8096
